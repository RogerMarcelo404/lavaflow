
# LavaFlow - Parâmetros de configuração
# Copie este arquivo para ".env" e preencha com os seus valores.


# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Conexão com o PostgreSQL ---
# Banco local: DB_HOST=localhost e DB_SSLMODE=disable
# Banco remoto (outro computador ou nuvem): use o endereço do servidor
# em DB_HOST e DB_SSLMODE=require para criptografar a conexão.
DB_NAME=lavaflow
DB_USER=lavaflow_app
DB_PASSWORD=troque_esta_senha
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10

# --- Regras do sistema ---
# Quantidade máxima de agendamentos por turno (manhã/tarde)
CAPACIDADE_POR_TURNO=8